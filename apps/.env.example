# Database Configuration (PostgreSQL)
POSTGRES_USER=orbit_user
POSTGRES_PASSWORD=orbit_super_secret_password_2026
POSTGRES_DB=orbit_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://orbit_user:orbit_super_secret_password_2026@localhost:5432/orbit_db?schema=public

# Backend (NestJS) Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=ausat_conae_2026_super_secure_orbit_jwt_secret_key_austral_engineering
JWT_EXPIRES_IN=7d
COOKIE_NAME=orbit_access_token
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Frontend (Next.js / Vite) Configuration
# El front llama a /api (mismo origen) y Next lo reenvía a este backend
BACKEND_INTERNAL_URL=http://localhost:3001

# Seeding & Security
SEED_INITIAL_USERS=true
