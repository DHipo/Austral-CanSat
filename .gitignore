# ==============================================================================
# AuSat Orbit Monorepo — Git Ignore Rules
# Universidad Austral • CanSat CONAE 2026
# ==============================================================================

# 1. Dependencias y Gestores de Paquetes
node_modules/
.pnpm-store/
.pnpm/
.yarn/
.npm/

# 2. Compilaciones y Bundles (Next.js, NestJS, Vite, TypeScript)
dist/
dist-ssr/
build/
.next/
out/
*.tsbuildinfo
*.tsbuildinfo*

# 3. Variables de Entorno y Secretos
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Preservar plantilla oficial de configuración
!.env.example

# Claves criptográficas y certificados
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# 4. Logs, Debug y Diagnóstico
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Base de Datos, Respaldos y Volúmenes Locales
*.sqlite
*.sqlite3
*.db
*.db-journal
backups/
*.dump

# Almacenamiento local de archivos subidos (Multer)
uploads/
apps/back/uploads/*
!apps/back/uploads/.gitkeep

# 6. Cobertura de Pruebas y Reportes
coverage/
.nyc_output/
*.lcov

# 7. Editores e IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# 8. Archivos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 9. Temporales y Scratchpad
tmp/
temp/
scratch/
*.tmp
